{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ai-sentiment-app",
    "main": "src/worker.py",
    "compatibility_date": "2026-09-24",
    "compatibility_flags": ["python_workers"], 
    "assets": {
      "directory": "./static",
      "binding": "ASSETS",
      "run_worker_first": true 
    }
  }